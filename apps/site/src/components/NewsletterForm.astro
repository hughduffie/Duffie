---
interface Props {
  /** `footer` is the plain footer form. `band` sits on the blue band with a lime button. */
  variant?: 'footer' | 'band';
  id: string;
}
const { variant = 'footer', id } = Astro.props;
---

<form class:list={['notes', `notes--${variant}`]} data-form="notes" novalidate>
  <label class="sr-only" for={id}>Email address</label>
  <input id={id} type="email" name="email" placeholder="Email address" autocomplete="email" required />
  <input class="hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <button class:list={['btn', variant === 'band' && 'btn--lime']} type="submit">Join</button>
</form>

<style>
  .notes {
    display: flex;
    width: 100%;
  }
  .notes input[type='email'] {
    flex: 1;
    min-width: 0;
    padding: 12px 16px;
    background: var(--white);
    border: 1.5px solid var(--paper-500);
    border-right: 0;
    border-radius: 0;
    font: var(--body-s);
    font-size: max(16px, 1em);
    color: var(--ink-900);
  }
  .notes--band input[type='email'] {
    border-color: var(--white);
    padding-inline: 24px;
  }
  .notes input[type='email']::placeholder {
    color: var(--ink-600);
    opacity: 1;
  }
  .notes input[type='email']:focus {
    outline: 3px solid var(--blue-500);
    outline-offset: -3px;
  }
  .notes--band input[type='email']:focus {
    outline-color: var(--ink-900);
  }
  .notes.is-error input[type='email'] {
    background: var(--red-200);
    border-color: var(--red-500);
  }
</style>

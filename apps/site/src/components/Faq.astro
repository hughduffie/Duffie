---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item, i) => (
      <details class="faq__item" open={i === 0}>
        <summary>
          <span class="h4">{item.q}</span>
          <span class="faq__mark h4" aria-hidden="true" />
        </summary>
        <p class="muted">{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq__item {
    border: 1.5px solid transparent;
  }
  .faq__item summary {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 24px;
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__mark::before {
    content: '+';
  }
  .faq__item:not([open]):hover {
    background: var(--blue-200);
    border-color: var(--blue-500);
  }
  .faq__item:not([open]):hover .faq__mark {
    color: var(--blue-500);
  }
  .faq__item[open] {
    background: var(--white);
    border: 2px solid var(--ink-900);
  }
  .faq__item[open] .faq__mark::before {
    content: '−';
  }
  .faq__item p {
    padding: 0 24px 24px;
    margin-top: -12px;
    max-width: 1000px;
  }
</style>

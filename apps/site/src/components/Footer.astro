---
import NewsletterForm from './NewsletterForm.astro';
import { site } from '@/data/site';
import linkedin from '@/assets/icons/linkedin.svg?raw';
import instagram from '@/assets/icons/instagram.svg?raw';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" class="pill" aria-label="HD Growth Advisory, home">HD GROWTH ADVISORY</a>
        <div class="footer__social">
          <a href={site.social.linkedin} target="_blank" rel="noopener" aria-label="Hugh Duffie on LinkedIn">
            <Fragment set:html={linkedin} />
          </a>
          <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Hugh Duffie on Instagram">
            <Fragment set:html={instagram} />
          </a>
        </div>
      </div>
      <ul class="footer__links">
        <li><a href="/advisory">Advisory</a></li>
        <li><a href="/resources">Resources</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Get in touch</a></li>
      </ul>
      <div class="footer__notes">
        <p>Monthly notes: one email a month on what I am seeing in consumer brands.</p>
        <NewsletterForm id="footer-notes-email" />
      </div>
    </div>
    <div class="footer__bottom">
      <p>© {year} HD Growth Advisory</p>
      <ul>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/cookies">Cookies</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--paper-100);
    padding: 48px 0 32px;
  }
  .footer .container {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .footer__top {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 28px;
    align-items: flex-start;
  }
  .pill {
    display: inline-flex;
    padding: 11px 22px;
    border: 2px solid var(--ink-900);
    border-radius: 999px;
    font: 400 22px/24px var(--figure);
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
  }
  .footer__social {
    display: flex;
    gap: 20px;
  }
  .footer__social a:hover {
    opacity: 0.7;
  }
  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer__links a {
    text-decoration: none;
  }
  .footer__links a:hover,
  .footer__bottom a:hover {
    color: var(--blue-500);
    text-decoration: underline;
  }
  .footer__notes {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 20px;
    border-top: 1px solid var(--paper-500);
    font: var(--label-s);
    letter-spacing: var(--label-s-ls);
    text-transform: uppercase;
    color: var(--ink-600);
  }
  .footer__bottom ul {
    display: flex;
    gap: 24px;
  }
  .footer__bottom a {
    text-decoration: none;
  }
  @media (min-width: 1024px) {
    .footer {
      padding: 80px 0 48px;
    }
    .footer .container {
      gap: 64px;
    }
    .footer__top {
      flex-direction: row;
      justify-content: space-between;
    }
    .footer__links {
      gap: 12px;
      min-width: 170px;
    }
    .footer__notes {
      width: 440px;
    }
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      padding-top: 24px;
    }
  }
</style>

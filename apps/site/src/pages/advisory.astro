---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import { site } from '@/data/site';

const { advisory, sprint } = site.offers;

const offers = [
  {
    name: 'Advisory',
    tone: 'blue',
    price: advisory.price,
    terms: advisory.terms,
    summary: 'Ongoing advice and coaching, and a second pair of eyes as you grow.',
    points: ['Monthly strategy call', 'Async support by email', 'Priority list kept up to date'],
  },
  {
    name: 'Sprint',
    tone: 'lime',
    price: sprint.price,
    terms: sprint.terms,
    summary: 'A focused piece of work on your biggest priority.',
    points: [
      'A short, focused engagement on one priority',
      'A clear plan and prioritised next steps',
      'Handover so your team can deliver',
    ],
  },
];

const topics = [
  { title: 'Priorities and plan', text: 'A short list for the next 90 days.' },
  { title: 'Shopify and conversion', text: 'Product pages, offers, subscriptions.' },
  { title: 'Email, SMS and CRM', text: 'Klaviyo flows and segmentation.' },
  { title: 'Meta ads and creative strategy', text: 'Message, hook, angle, format, offer.' },
  { title: 'Creator marketing', text: 'Finding, briefing and paying creators.' },
  { title: 'Brand systems and AI', text: 'Brand guidelines your team can use, built in Figma with code.' },
];

const fit = [
  'Founders and brand teams selling direct to consumers',
  'Teams with some sales and a long list of ideas',
  'People who want a straight answer',
];
const notFit = [
  'Brands that want a full agency to run everything',
  'Pre-product ideas with no customers yet',
  'Anyone after guaranteed results',
];

const faqs = [
  {
    q: 'What happens after I send a Loom?',
    a: `I watch it and reply, usually within ${site.replyTime}. If I can help, I suggest a next step, often a short call. If not, I say so plainly.`,
  },
  {
    q: 'Do you work with brands outside food and drink?',
    a: 'Yes. Food and drink is where I have spent the most time, but I have also worked with beauty, homeware and wellbeing brands. What matters more is that you sell a consumer product and sell at least some of it direct.',
  },
  {
    q: 'Can you run our ads or email for us?',
    a: 'No. I advise and coach, and you and your team do the delivery. Where you need more hands, I can introduce freelancers or agencies I trust.',
  },
  {
    q: 'Who owns the work?',
    a: 'You do. Any plans, briefs and documents we produce are yours to keep and use.',
  },
];
---

<Base
  title="Advisory and coaching"
  description="Two ways to work with Hugh Duffie: ongoing advisory and coaching, or a one-off sprint on your biggest priority. For founders of consumer brands."
>
  <Nav slot="nav" current="advisory" />

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Advisory and coaching</p>
      <h1 class="display">Straight advice on growth.</h1>
      <p class="body-l muted lede">
        For founders and brand teams who need a clear view on what to do first. I look at your numbers, your
        channels, your culture and your creative, and tell you plainly what I would do. Then I coach you and your
        team while you do it.
      </p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Working together</p>
        <h2 class="h2">Two ways to work together</h2>
        <p class="muted">Ongoing advice, or a one-off sprint. No tiers.</p>
      </div>
      <div class="offers">
        {
          offers.map((o) => (
            <article class:list={['offer leaf', `offer--${o.tone}`]}>
              <div class="dots" aria-hidden="true">
                <i class="on" />
                <i />
                <i />
              </div>
              <h3 class="h4">{o.name}</h3>
              <p class="offer__price">
                <span class="h3">{o.price ?? 'Price on request'}</span>
                <span class="muted">{o.terms}</span>
              </p>
              <p class="muted">{o.summary}</p>
              <ul class="dot-list">
                {o.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
              <a class="btn" href="/contact">
                Get in touch
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-paper">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What we work on</p>
        <h2 class="h2">Six things I get asked about most</h2>
      </div>
      <ul class="topics">
        {
          topics.map((t) => (
            <li>
              <h3 class="h4">{t.title}</h3>
              <p class="muted">{t.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <h2 class="sr-only">Who it is for</h2>
      <div class="fit">
        <div class="fit__card fit__card--yes leaf">
          <h3 class="h3">Good fit</h3>
          <ul class="dot-list" style="--dot: var(--ink-900)">
            {fit.map((f) => <li>{f}</li>)}
          </ul>
        </div>
        <div class="fit__card leaf">
          <h3 class="h3">Not a fit</h3>
          <ul class="dot-list" style="--dot: var(--ink-900)">
            {notFit.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-paper">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2 class="h2">Before you get in touch</h2>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand
    title="Ready to start?"
    text="Get in touch. If you send me a Loom, I will get back to you."
    cta="Get in touch"
    href="/contact"
  />
</Base>

<style>
  .page-hero {
    padding: 48px 0 var(--section-y);
  }
  .page-hero .container {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .lede {
    max-width: 900px;
  }
  .offers {
    display: grid;
    gap: var(--gap);
  }
  .offer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding: 32px;
    border: 2px solid var(--ink-900);
  }
  .offer--blue {
    background: var(--blue-200);
  }
  .offer--lime {
    background: var(--lime-200);
  }
  .offer .dots {
    margin-bottom: 28px;
  }
  .offer__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }
  .offer__price .h3 {
    color: var(--blue-500);
  }
  .offer .dot-list {
    flex: 1;
    margin-bottom: 12px;
  }
  .topics {
    display: grid;
    gap: 24px;
  }
  .topics li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    background: var(--white);
    border: 1.5px solid var(--paper-500);
  }
  .fit {
    display: grid;
    gap: var(--gap);
  }
  .fit__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 40px;
    background: var(--paper-100);
  }
  .fit__card--yes {
    background: var(--lime-200);
  }
  @media (max-width: 599px) {
    .fit__card {
      padding: 32px 24px;
    }
  }
  @media (min-width: 600px) {
    .topics {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .offers,
    .fit {
      grid-template-columns: repeat(2, 1fr);
    }
    .fit {
      gap: 48px;
    }
    .topics {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

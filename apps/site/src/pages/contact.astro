---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import { site } from '@/data/site';

const steps = [
  { title: 'Record a Loom', text: 'Five minutes or less. The free Loom plan is enough.' },
  {
    title: 'Answer two questions',
    text: 'The biggest blocker right now, and what you would do if you could start again.',
  },
  { title: 'Send me the link', text: 'I reply with a straight view and a next step, or tell you it is not a fit.' },
];
---

<Base
  title="Get in touch"
  description="Send Hugh Duffie a short Loom about your brand. He replies with a straight view and a next step, or tells you it is not a fit."
>
  <Nav slot="nav" />

  <section class="intake">
    <div class="container intake__inner" data-form-wrap>
      <div class="intake__copy">
        <p class="eyebrow">Get in touch</p>
        <h1 class="display" data-swap-on-success="form">Get in touch.</h1>
        <h1 class="display" data-swap-on-success="success" hidden>Got it. Thank you.</h1>
        <p class="body-m muted" data-swap-on-success="form">
          I have a full-time job and a young family, so I cannot jump on a call. If you send me a Loom, I will get
          back to you.
        </p>
        <p class="body-m muted" data-swap-on-success="success" hidden>
          I will watch it and reply, usually within {site.replyTime}. If I can help, I will suggest a next step,
          often a short call. If not, I will say so plainly.
        </p>

        <div class="intake__how" data-swap-on-success="form">
          <h2 class="label">How it works</h2>
          <ol class="steps">
            {
              steps.map((s, i) => (
                <li>
                  <span class="figure" aria-hidden="true">
                    {i + 1}
                  </span>
                  <div>
                    <h3 class="h4">{s.title}</h3>
                    <p class="muted">{s.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="questions leaf">
            <p class="label">In your Loom, answer two questions</p>
            <p class="h4">What is the biggest blocker right now?</p>
            <p class="h4">If you could start again, without the baggage of what came before, what would you do?</p>
          </div>
          <p class="muted">
            I take a small number of founders at a time, so a short Loom lets me see quickly whether I can help. If
            I cannot, I will say so plainly.
          </p>
        </div>
      </div>

      <form class="intake__card leaf" data-state="form" data-form="loom" novalidate>
        <h2 class="h3">Send your Loom</h2>
        <div class="field">
          <label for="loom-name">First name</label>
          <input
            id="loom-name"
            name="firstName"
            type="text"
            autocomplete="given-name"
            placeholder="Alex"
            required
            data-error="Add your first name."
          />
          <p class="help">So I know what to call you.</p>
        </div>
        <div class="field">
          <label for="loom-email">Email</label>
          <input
            id="loom-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="alex@example.com"
            required
            data-error="Check the email address and try again."
          />
          <p class="help">I reply to this address.</p>
        </div>
        <div class="field">
          <label for="loom-brand">Brand and website</label>
          <input
            id="loom-brand"
            name="brand"
            type="text"
            placeholder="Example Co, example.co"
            required
            data-error="Add your brand and website."
          />
          <p class="help">So I can look before I watch.</p>
        </div>
        <div class="field">
          <label for="loom-link">Your Loom link</label>
          <input
            id="loom-link"
            name="loom"
            type="url"
            inputmode="url"
            placeholder="https://www.loom.com/share/…"
            required
            data-error="That does not look like a Loom link. It should start with loom.com/share."
          />
          <p class="help">Set sharing to anyone with the link. New to Loom? The free plan is enough.</p>
        </div>
        <p class="form-note" data-loom-ok hidden>Loom link recognised.</p>
        <div class="field">
          <label for="loom-revenue">Roughly how big is the brand? (optional)</label>
          <input id="loom-revenue" name="revenue" type="text" placeholder="Annual revenue, for example £500k to £1m" />
          <p class="help">Only so I know the stage you are at.</p>
        </div>
        <label class="check">
          <input type="checkbox" name="consent" required />
          <span
            >I agree to Hugh storing my details and Loom to reply to me. Unsubscribe from any emails at any time.</span
          >
        </label>
        <input class="hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <p class="form-alert" role="alert" hidden>Please add a Loom link and tick the box to send.</p>
        <button class="btn btn--block" type="submit" data-ready-when-valid aria-disabled="true">Send my Loom</button>
        <p class="muted">I usually reply within {site.replyTime}.</p>
      </form>

      <div class="intake__card leaf" data-state="success" hidden>
        <div class="sent-dots" aria-hidden="true"><i></i><i></i><i class="lime"></i></div>
        <h2 class="h3">Loom received</h2>
        <p class="muted">
          Thanks, <span data-fill="firstName">there</span>. I have sent a confirmation to
          <span data-fill="email">your email address</span>. If you do not see it in a few minutes, check
          promotions or spam.
        </p>
        <div class="summary">
          <p class="label-s muted">What you sent</p>
          <p>Brand: <span data-fill="brand"></span></p>
          <p>Loom: <span data-fill="loom"></span></p>
        </div>
        <div class="intake__next">
          <a class="btn btn--secondary" href="/values-exercise">Try the values exercise</a>
          <a class="btn btn--text" href="/resources">Read the free guides <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .intake {
    padding: 48px 0 var(--section-y);
  }
  .intake__inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .intake__copy,
  .intake__how {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .steps {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .steps li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
  }
  .steps li > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .questions {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px 32px;
    background: var(--lime-200);
  }
  .questions .label {
    color: var(--lime-900);
    padding-right: 32px;
  }
  .intake__card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 32px 24px;
    background: var(--white);
    border: 2px solid var(--ink-900);
  }
  .summary {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 20px;
    background: var(--paper-100);
    overflow-wrap: anywhere;
  }
  .intake__next {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .sent-dots {
    display: flex;
    gap: 8px;
  }
  .sent-dots i {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--ink-900);
  }
  .sent-dots i.lime {
    background: var(--lime-400);
  }
  @media (min-width: 600px) {
    .intake__card {
      padding: 40px;
    }
  }
  @media (min-width: 1024px) {
    .intake {
      padding-bottom: 120px;
    }
    .intake__inner {
      flex-direction: row;
      align-items: flex-start;
      gap: 80px;
    }
    .intake__copy {
      flex: 1;
      min-width: 0;
      max-width: 560px;
    }
    .intake__card {
      flex: 1;
      max-width: 640px;
      margin-left: auto;
    }
  }
</style>

# CRM Canvas — local environment
# Copy to .env.local and fill in. NEVER commit a filled-in copy.

# ---------------------------------------------------------------------------
# Klaviyo
# ---------------------------------------------------------------------------
# Private API key for the account being audited.
# Create at: Klaviyo > Settings > API keys > Create private API key.
# Required scopes (read-only, nothing else):
#   accounts:read  campaigns:read  flows:read  templates:read  profiles:read  metrics:read
#
# In V1 this may also be entered in the UI and held in memory for the run.
# It is never written to the database in plaintext.
KLAVIYO_PRIVATE_API_KEY=

# Email address of the Klaviyo profile used as preview/personalization context.
PREVIEW_PROFILE_EMAIL=

# ---------------------------------------------------------------------------
# Supabase (Phase 8 onward)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser or the Figma plugin.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=crm-canvas

# ---------------------------------------------------------------------------
# Web app
# ---------------------------------------------------------------------------
# Origin the Figma plugin fetches the audit manifest from. Must match the
# allowedDomains entry in apps/figma-plugin/manifest.json.
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Renderer worker (Phase 4 onward)
# ---------------------------------------------------------------------------
# Concurrent Chromium contexts. Raise carefully: each one is a browser tab.
RENDER_CONCURRENCY=3
RENDER_TIMEOUT_MS=30000
RENDER_MAX_ATTEMPTS=3
